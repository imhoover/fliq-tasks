{
  "name": "fliq-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "preview": "wrangler dev --port 5179 --var APP_ORIGIN:http://127.0.0.1:5179",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply fliq-db --local",
    "db:remote": "wrangler d1 migrations apply fliq-db --config wrangler.production.jsonc --remote",
    "deploy:check": "wrangler deploy --config wrangler.production.jsonc --dry-run --outdir artifacts/worker-dryrun",
    "release:check": "node scripts/release-check.mjs",
    "deploy": "npm run release:check && npm run build && wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20261012.1-beta",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
